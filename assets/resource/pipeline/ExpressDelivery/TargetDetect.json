{
    "ExpressDeliveryEnterBigMap": {
        "desc": "打开武陵城大地图用于运送目标识别",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "SceneEnterMapWulingWulingCity"
                    ]
                }
            }
        },
        "post_delay": 0,
        "next": [
            "ExpressDeliveryPanToT1"
        ],
        "focus": {
            "Node.Action.Succeeded": "已进入武陵城大地图"
        }
    },
    "ExpressDeliveryPanToT1": {
        "desc": "平移大地图将候选 T1 [170, 679] 纳入视口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InMapWulingWulingCity"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MapTrackerBigMapPick",
                "custom_action_param": {
                    "map_name": "map02_lv002",
                    "target": [
                        170,
                        679
                    ],
                    "on_find": "DoNothing"
                }
            }
        },
        "post_wait_freezes": 300,
        "post_delay": 0,
        "next": [
            "ExpressDeliveryCheckT1",
            "ExpressDeliveryPanToT2"
        ]
    },
    "ExpressDeliveryCheckT1": {
