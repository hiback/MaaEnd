        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MapTrackerFindMarkerOnBigMap",
                "custom_recognition_param": {
                    "map_name": "map02_lv002",
                    "target": [
                        170,
                        679
                    ],
                    "template": "ExpressDelivery/DeliveryTargetIcon.png",
                    "green_mask": true,
                    "threshold": 0.8,
                    "tolerance": 24
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
